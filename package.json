{
  "name": "purdia",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint src/ packages/ --cache",
    "lint:fix": "eslint src/ packages/ --fix --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt src/ packages/"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@purdia/auth": "*",
    "@purdia/charts": "*",
    "@purdia/composables": "*",
    "@purdia/crypto": "*",
    "@purdia/http": "*",
    "@purdia/tailwind": "*",
    "@purdia/theme": "*",
    "@purdia/toast": "*",
    "@purdia/ui": "*",
    "@purdia/utils": "*",
    "@tiptap/extension-code-block-lowlight": "^3.27.3",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-highlight": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/extension-task-item": "^3.27.3",
    "@tiptap/extension-task-list": "^3.27.3",
    "@tiptap/extension-text-align": "^3.27.3",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@tiptap/vue-3": "^3.27.3",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "lowlight": "^3.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.1.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.10.0",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.54.0",
    "tailwindcss": "^4.3.2",
    "terser": "^5.49.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.33.0",
    "vite": "^8.0.16",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^3.2.3",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
